---
import '../styles/global.css';
import Consent from '../components/Consent.astro';
interface Props{title:string;description:string;noindex?:boolean;}
const {title,description,noindex=false}=Astro.props;const canonical=new URL(Astro.url.pathname,'https://chandragiritop.com').href;
const photoAlt='चन्द्रागिरि गाइडको मौलिक सांकेतिक केबल कार चित्र; वास्तविक स्टेशन वा मार्गको नक्सा होइन';
---
<!doctype html><html lang="ne"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:locale" content="ne_NP"/><meta property="og:image" content="https://chandragiritop.com/images/chandragiri-social.jpg"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={photoAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://chandragiritop.com/images/chandragiri-social.jpg"/><meta name="twitter:image:alt" content={photoAlt}/><link rel="icon" href="/icons/favicon.svg"/><meta name="theme-color" content="#193c31"/><slot name="head"/></head><body><a class="skip" href="#main">मुख्य सामग्रीमा जानुहोस्</a><header><div class="shell header-shell"><a href="/" class="brand"><img src="/logo.svg" width="240" height="64" alt="चन्द्रागिरि माथिल्लो स्टेसन गाइड"/></a><details class="menu"><summary>विषय सूची ▾</summary><nav aria-label="पानाका विषय"><a href="/#plan">माथि र तलको फरक</a><a href="/#timings">समय र अन्तिम सवारी</a><a href="/#tickets">टिकट</a><a href="/#contact">सम्पर्क</a><a href="/#map">नक्सा</a><a href="/#weather">मौसम</a><a href="/#faq">FAQ</a><a href="/#sources">स्रोत</a></nav></details><a class="contact-link" href="/#contact">सम्पर्क</a></div></header><main id="main"><slot/></main><footer class="section"><div class="shell"><p>स्वतन्त्र, गैरआधिकारिक, गैरनाफामूलक पर्यटन तथा शैक्षिक जानकारी गाइड। यो Chandragiri Hills, केबल कार सञ्चालक, मन्दिर वा रिसोर्टको आधिकारिक साइट होइन।</p><p><a href="/privacy/">गोपनीयता</a> · <a href="/terms/">प्रयोग सर्तहरू</a> · <button type="button" data-cookie-settings>Google Analytics रोजाइ बदल्नुहोस्</button></p><p class="small">वैकल्पिक Google Analytics र स्वतन्त्र Cloudflare होस्टिङ मापनको दायरा गोपनीयता पानामा छ।</p></div></footer><Consent/></body></html>
