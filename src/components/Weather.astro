---
import {getForecast} from '../lib/weather';
import {parseForecast,modelSignal} from '../lib/weather-model';
const data=await getForecast();const report=data?parseForecast(data.payload):null;
const C={title:'पहाड वरिपरिको प्रादेशिक मौसम',error:'हाल पर्याप्त नयाँ र वैध पूर्वानुमान उपलब्ध छैन। पुरानो वा वैकल्पिक संख्या देखाइएको छैन।',temp:'तापक्रम',wind:'हावा',rain:'दिनको अधिकतम वर्षा सम्भावना',uv:'दिनको अधिकतम UV',model:'मोडेल समय',retrieved:'प्रदायकबाट प्राप्त',checked:'पानाको जाँच',thunder:'मोडेलमा चट्याङको सङ्केत छ; आधिकारिक चेतावनी र सञ्चालकको हालको सूचना जाँच्नुहोस्।',heavyRain:'मोडेलमा भारी वर्षाको सङ्केत छ; चेतावनी र स्थानीय अवस्था जाँच्नुहोस्।',fog:'मोडेलमा कुहिरोको सङ्केत छ; दृश्यता र यातायातको अवस्था जाँच्नुहोस्।'};
const labels:Record<number,string>={0:'सफा आकाश',1:'मुख्यतया सफा',2:'आंशिक बदली',3:'बदली',45:'कुहिरो',48:'जम्ने कुहिरो',51:'हल्का सिमसिम',53:'सिमसिम',55:'बाक्लो सिमसिम',56:'जम्ने हल्का सिमसिम',57:'जम्ने बाक्लो सिमसिम',61:'हल्का वर्षा',63:'मध्यम वर्षा',65:'भारी वर्षा',66:'हल्का जम्ने वर्षा',67:'भारी जम्ने वर्षा',71:'हल्का हिमपात',73:'मध्यम हिमपात',75:'भारी हिमपात',77:'हिउँका कण',80:'हल्का फुहारा',81:'मध्यम फुहारा',82:'अत्यधिक फुहारा',85:'हिउँका फुहारा',86:'भारी हिउँका फुहारा',95:'चट्याङसहित आँधी',96:'चट्याङ र असिना',99:'भारी असिनासहित चट्याङ'};
const format=(at:number)=>new Date(at).toLocaleString('en-GB',{timeZone:'Asia/Kathmandu'});
---
<section id="weather" class="section"><div class="shell"><h2>{C.title}</h2><p>यो चन्द्रागिरि नजिकको स्थिर क्षेत्र-बिन्दुको Open-Meteo मोडेल हो, स्टेशनको प्रत्यक्ष मापन होइन। माथिल्लो र तल्लो स्टेशन तथा सम्पूर्ण केबल लाइनको हावा एउटै नहुन सक्छ। यसले सञ्चालन, अन्तिम सवारी वा सुरक्षा अनुमति पुष्टि गर्दैन।</p><div id="weather-root" aria-live="polite">{report&&data?<><div class="card"><h3>{C.temp}: {Math.round(report.current.temperature)}°C</h3><p>{labels[report.current.code]}</p><p>{C.wind}: {Math.round(report.current.wind)} km/h</p><p>{C.rain}: {report.days[0].probability}%</p>{report.days[0].uv!==null&&<p>{C.uv}: {report.days[0].uv}</p>}{modelSignal(report.current.code)&&<p class="weather-warning">{C[modelSignal(report.current.code)!]}</p>}<p class="small">{C.model}: {report.modelTime} · Asia/Kathmandu</p><p class="small">{C.retrieved}: {format(data.retrievedAt)}</p><p class="small">{C.checked}: {format(Date.now())}</p></div><div class="weather-grid">{report.days.map(d=><div class="card"><h3>{d.date}</h3><p>{labels[d.code]}</p><p>{Math.round(d.min)}° / {Math.round(d.max)}°C</p><p>{C.rain}: {d.probability}%</p>{modelSignal(d.code)&&<p class="weather-warning">{C[modelSignal(d.code)!]}</p>}</div>)}</div></>:<p class="card">{C.error}</p>}</div><script id="weather-copy" type="application/json" is:inline set:html={JSON.stringify({C,labels})}/><p class="small">पाना सक्रिय हुँदा १५ मिनेटमा पुनःजाँच हुन्छ। पर्याप्त नयाँ डेटा नभए संख्या हटाइन्छ; वार्षिक औसतलाई हालको मौसम भनिएको छैन। वर्षाको सम्भावना र मौसमको तीव्रता फरक हुन्।</p><p><a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · <a href="https://www.dhm.gov.np/">नेपाल जल तथा मौसम विज्ञान विभाग</a></p></div></section>
<script>
import {parseForecast,modelSignal} from '../lib/weather-model';
const root=document.getElementById('weather-root'),copy=document.getElementById('weather-copy');
if(root&&copy){const{C,labels}=JSON.parse(copy.textContent||'{}');let last=Date.now(),loading=false;
const el=(tag:string,text:string,cls='')=>{const e=document.createElement(tag);e.textContent=text;e.className=cls;return e;};const format=(n:number)=>new Date(n).toLocaleString('en-GB',{timeZone:'Asia/Kathmandu'});const clear=()=>{root.replaceChildren(el('p',C.error,'card'));last=0;};
const load=async()=>{if(loading)return;loading=true;try{const response=await fetch('/api/weather.json',{cache:'no-store',signal:AbortSignal.timeout(12000)});if(!response.ok)throw Error('status');const data=await response.json();const report=parseForecast(data.payload);if(!report||typeof data.retrievedAt!=='number'||!Number.isFinite(data.retrievedAt)||Date.now()-data.retrievedAt>30*60000||data.retrievedAt>Date.now()+60000)throw Error('invalid');const n=report.current,d=report.days[0],card=el('div','','card');card.append(el('h3',`${C.temp}: ${Math.round(n.temperature)}°C`),el('p',labels[n.code]),el('p',`${C.wind}: ${Math.round(n.wind)} km/h`),el('p',`${C.rain}: ${d.probability}%`));if(d.uv!==null)card.append(el('p',`${C.uv}: ${d.uv}`));const signal=modelSignal(n.code);if(signal)card.append(el('p',C[signal],'weather-warning'));card.append(el('p',`${C.model}: ${report.modelTime} · Asia/Kathmandu`,'small'),el('p',`${C.retrieved}: ${format(data.retrievedAt)}`,'small'),el('p',`${C.checked}: ${format(Date.now())}`,'small'));const grid=el('div','','weather-grid');for(const d of report.days){const item=el('div','','card');item.append(el('h3',d.date),el('p',labels[d.code]),el('p',`${Math.round(d.min)}° / ${Math.round(d.max)}°C`),el('p',`${C.rain}: ${d.probability}%`));const signal=modelSignal(d.code);if(signal)item.append(el('p',C[signal],'weather-warning'));grid.append(item);}root.replaceChildren(card,grid);last=Date.now();}catch{clear();}finally{loading=false;}};
load();setInterval(()=>{if(document.visibilityState==='visible')load();else if(last&&Date.now()-last>30*60000)clear();},15*60000);document.addEventListener('visibilitychange',()=>{if(document.visibilityState!=='visible')return;if(last&&Date.now()-last>30*60000)clear();if(!last||Date.now()-last>15*60000)load();});}
</script>
