---
import Base from '../layouts/Base.astro';
import Weather from '../components/Weather.astro';
import TopicLinks from '../components/TopicLinks.astro';
import {sections,faq,sources,checked} from '../data/guide';
export const prerender=false;
const origin='https://chandragiritop.com',url=origin+'/';
const schema=[{'@context':'https://schema.org','@type':'TouristAttraction','@id':url+'#attraction',name:'Chandragiri Cable Car Top Station',alternateName:'चन्द्रागिरि केबल कार माथिल्लो स्टेसन',url,hasMap:sources.maps},{'@context':'https://schema.org','@type':'WebSite','@id':url+'#website',name:'Chandragiri Top independent guide',url,inLanguage:'ne'},{'@context':'https://schema.org','@type':'WebPage','@id':url+'#webpage',url,name:'Chandragiri Cable Car Top Station — Boarding, Fare & Last-ride Checks',inLanguage:['ne','en'],about:{'@id':url+'#attraction'},isPartOf:{'@id':url+'#website'}},{'@context':'https://schema.org','@type':'FAQPage','@id':url+'#faq',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,inLanguage:f.lang,acceptedAnswer:{'@type':'Answer',text:f.a,inLanguage:f.lang}}))}];
---
<Base title="Chandragiri Cable Car Top Station | टिकट, सम्पर्क र अन्तिम सवारी जाँच" description="चन्द्रागिरि माथिल्लो स्टेसन र थानकोट बोर्डिङको फरक, सञ्चालकका परस्पर फरक समय, NPR/INR/USD दर, केबल कार सम्पर्क र अन्तिम तल झर्ने समय कसरी पुष्टि गर्ने।">
<Fragment slot="head">{schema.map(x=><script type="application/ld+json" is:inline set:html={JSON.stringify(x)}/>)}</Fragment>
<section class="hero section"><div class="shell"><p class="kicker">चन्द्रागिरि · बागमती · नेपाल</p><h1>चन्द्रागिरि केबल कार माथिल्लो स्टेसन <span lang="en">Chandragiri Cable Car Top Station</span></h1><p class="lead">माथिल्लो गन्तव्य, तल्लो बोर्डिङ र तल फर्किने सेवा छुट्याएर योजना बनाउनुहोस्। टिकट तथा समय सञ्चालकको स्रोत र मिति सहित जाँच्नुहोस्।</p><p><a class="button" href="#timings">समयको फरक बुझ्नुहोस्</a> <a class="button secondary" href="#contact">केबल कार सम्पर्क</a></p><p class="badge">★ 4.5 / 5 · 10,330 Google Maps · {checked}</p><p class="small">हातैले जाँचिएको मिति-झलक; स्वतः अद्यावधिक हुँदैन।</p><figure><img src="/images/chandragiri-top-station.jpg" width="1280" height="960" alt="Chandragiri Cable Car top station on Chandragiri Hill, Nepal — वास्तविक फोटो" fetchpriority="high"/><figcaption>चन्द्रागिरि केबल कार माथिल्लो स्टेशनको वास्तविक फोटो — Roman Raghu Shrestha, 2016 · <a href="https://commons.wikimedia.org/wiki/File:View_from_chandragiri_32.jpg">Wikimedia Commons</a> · <a href="#image-credits">तस्बिर स्रोत</a></figcaption></figure></div></section>
<div class="shell content">{sections.map(s=><section id={s.id} class="section"><h2>{s.title}</h2>{s.text.map(t=><p>{t}</p>)}{s.id==='timings'&&<div class="table-wrap"><table><caption>सञ्चालकका पाना — हेरेको मिति {checked}</caption><thead><tr><th>स्रोत</th><th>पानाले भनेको सञ्चालन</th><th>पानाले भनेको ब्रेक</th></tr></thead><tbody><tr><td><a href={sources.faq}>FAQ</a></td><td>सोम–बिही 08:00–18:00; शुक्र/शनि 08:00–21:00; आइतबार यस उत्तरमा उल्लेख छैन</td><td>12:30–13:30</td></tr><tr><td><a href={sources.ride}>Cable Car</a></td><td>आइत–शुक्र 08:00–18:00; शनि 08:00–20:00</td><td>आइत–शुक्र 12:00–13:00; शनि/सार्वजनिक बिदामा ब्रेक नभएको उल्लेख</td></tr></tbody></table></div>}{s.id==='tickets'&&<><div class="table-wrap"><table><caption>Cable Car पानामा प्रकाशित दर · {checked} मा हेरेको</caption><thead><tr><th>श्रेणी</th><th>Two Way</th><th>One Way</th><th>Express Two Way</th></tr></thead><tbody><tr><td>नेपाली</td><td>NPR 850</td><td>NPR 510</td><td>NPR 1350</td></tr><tr><td>SAARC</td><td>INR 950</td><td>INR 570</td><td>INR 1250</td></tr><tr><td>अन्य विदेशी</td><td>USD 23</td><td>USD 13</td><td>USD 25</td></tr></tbody></table></div><p><a href={sources.ride}>दरको मूल स्रोत ↗</a> · <a href={sources.tickets}>सञ्चालकको पानाबाट टिकट जाँच्नुहोस् ↗</a></p></>}{s.id==='contact'&&<p><a class="button" href="tel:+9779802069900">+977-9802069900</a> <a href={sources.contact}>सम्पर्कको मूल स्रोत ↗</a></p>}{s.id==='map'&&<p><a href={sources.maps}>Google Maps स्थान-सन्दर्भ ↗</a> · <a href={sources.route}>सञ्चालकको Route to the Hills ↗</a></p>}{s.id==='reviews'&&<p><a href={sources.maps}>Google Maps को मूल पाना ↗</a></p>}</section>)}</div>
<Weather/>
<TopicLinks />
<section id="english" class="section"><div class="shell" lang="en"><h2>Top station versus boarding — English summary</h2><p>This is an independent guide to the hilltop destination. Road arrivals board at the Thankot-side Bottom Station; a Top Station Maps point is not a verified base-station counter or pickup.</p><p>The operator FAQ and Cable Car pages conflict on closing times and lunch breaks. Do not infer the last ticket, ascent or descent from either general timetable. Confirm today’s service and return arrangement with the cable-car operator at <a href="tel:+9779802069900">+977-9802069900</a>.</p><p>The published fare table was checked on {checked}, separating Nepalese, SAARC and other-foreign categories in NPR, INR and USD. Confirm citizenship eligibility, one-way/return/express product, documents and final price. A regional forecast cannot establish safe operation or guaranteed Himalayan views.</p><p>Maps 4.5/5 from 10,330 reviews is a manual {checked} snapshot, not automatically updated or collected by this guide. The top-station photograph dates from 2016 and does not verify current conditions.</p></div></section>
<section id="faq" class="section"><div class="shell"><h2>सामान्य प्रश्न</h2>{faq.map(f=><details class="card faq" lang={f.lang}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
<section id="sources" class="section"><div class="shell"><h2>स्रोत र जाँचको सीमा</h2><p>स्रोत हेरेको मिति {checked} (लस एन्जलसको मिति)। पानाको सूची, प्रचार सामग्री वा Maps झलक प्रत्यक्ष स्थान-जाँच होइन। सञ्चालकका दुई पानाको समय फरक भएकाले हालको बन्द हुने वा अन्तिम ओरालो समय पुष्टि भएको भनिएको छैन।</p><ul><li><a href={sources.ride}>Chandragiri Hills — Cable Car</a>: दर, मुद्रा, श्रेणी, समय, बोर्डिङ सहायता र सवारी विवरण।</li><li><a href={sources.faq}>Chandragiri Hills — FAQ</a>: फरक समय/ब्रेक, लाइन, उमेर र क्याबिन नियम।</li><li><a href={sources.contact}>Chandragiri Hills — Contact</a>: केबल कारका लागि छुट्टै नम्बर।</li><li><a href={sources.maps}>Google Maps</a>: {checked} को हातैले जाँचिएको समीक्षा/ठेगाना/प्रवेश झलक।</li></ul><p>टिकट, आजको सेवा, मार्गको सुलभता, खाद्य सुविधा र विशेष गतिविधि यात्रा अघि सम्बन्धित सञ्चालकसँग पुष्टि गर्नुहोस्।</p></div></section>
<section id="image-credits" class="section"><div class="shell"><h2>चित्र र अधिकार</h2><p>माथिल्लो स्टेशनको वास्तविक फोटो Roman Raghu Shrestha ले सन् २०१६ मा खिच्नुभएको हो; <a href="https://commons.wikimedia.org/wiki/File:View_from_chandragiri_32.jpg">Wikimedia Commons मा स्रोत र इजाजत विवरण</a> उपलब्ध छ। यो आजको सञ्चालन अवस्थाको प्रमाण होइन।</p><p>पहिलेको मौलिक सांकेतिक SVG र JPEG चित्र फाइलहरू यथावत् राखिएका छन्; ती <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a> अन्तर्गत छन् र वास्तविक स्टेशन वा मार्गको नक्सा होइनन्।</p></div></section>
</Base>
