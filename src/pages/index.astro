        <div class="mt-10 divide-y divide-[#d8e0d9] border-y border-[#d8e0d9]">{faq.map(({q,a}) => <details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-black"><span>{q}</span><span class="text-[#b6422b] group-open:rotate-45">＋</span></summary><p class="max-w-3xl pt-4 leading-8 text-[#53675e]">{a}</p></details>)}</div>
