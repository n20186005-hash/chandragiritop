{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chandragiritop",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": true
  }
}
