            ].map(([t,d]) => <article class="rounded-3xl bg-white p-6 text-[#10231d]"><h3 class="text-xl font-black">{t}</h3><p class="mt-2 text-sm leading-6 text-[#53675e]">{d}</p></article>)}
          </div></div>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid gap-6 lg:grid-cols-3">
          <article class="rounded-[2rem] border border-[#d8e0d9] p-7 lg:col-span-2"><p class="text-sm font-black uppercase tracking-[.25em] text-[#b6422b]">विस्तृत यातायात</p><h2 class="mt-3 text-3xl font-black">काठमाडौँ → थानकोट → माथिल्लो स्टेशन</h2><div class="mt-6 grid gap-5 md:grid-cols-2"><div><h3 class="font-black">ट्याक्सी / राइड-हेलिङ</h3><p class="mt-2 leading-7 text-[#53675e]">काठमाडौँ केन्द्रबाट तल्लो स्टेशनसम्म सबैभन्दा सीधा विकल्प। ट्राफिकअनुसार यात्रा समय फरक हुन्छ। नक्सामा “Chandragiri Hills Cable Car Base Station” राख्नुहोस्।</p></div><div><h3 class="font-black">सार्वजनिक यातायात</h3><p class="mt-2 leading-7 text-[#53675e]">कलंकी/थानकोटतर्फ जाने बस वा माइक्रो प्रयोग गरी थानकोट नजिक पुगेर स्थानीय सवारी वा पैदलमार्फत आधार स्टेशनतर्फ जान सकिन्छ।</p></div></div></article>
          <article class="rounded-[2rem] bg-[#f6f3e7] p-7"><p class="text-sm font-black uppercase tracking-[.25em] text-[#9b7622]">पार्किङ</p><h2 class="mt-3 text-3xl font-black">तल्लो स्टेशनमा</h2><p class="mt-6 leading-7 text-[#53675e]">सञ्चालकको वार्षिक प्रतिवेदनमा तल्लो स्टेशनमा करिब २०० कार र ५०० मोटरसाइकल अट्ने पार्किङ क्षमता उल्लेख छ। व्यस्त शनिबार/बिदामा चाँडै पुग्नु उपयुक्त हुन्छ।</p></article>
        </div>
