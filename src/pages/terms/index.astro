export const prerender = true;
---
<Base title="प्रयोग सर्तहरू | चन्द्रागिरि गाइड" description="स्वतन्त्र मार्गदर्शकको स्रोत, सञ्चालन, टिकट, नक्सा र मौसमको सीमा।" noindex>
  <section class="section"><div class="shell prose">
    <h1>प्रयोग सर्तहरू</h1>
    <p>यो स्वतन्त्र, गैरआधिकारिक, गैरनाफामूलक पर्यटन तथा शैक्षिक जानकारी गाइड हो। हामी केबल कार, मन्दिर वा रिसोर्ट सञ्चालन गर्दैनौँ र टिकट वा आरक्षण सेवा दिँदैनौँ।</p>

    <h2>सर्तहरूको स्वीकृति</h2>
    <p>यस साइट प्रयोग वा भ्रमण गरेर तपाईंले यी सर्तहरू स्वीकार गर्नुभएको मानिन्छ। यसका कुनै भागसँग असहमत भएमा कृपया साइट प्रयोग नगर्नुहोस्।</p>

    <h2>सेवाको प्रयोग</h2>
    <p>स्रोतमा देखिएको टिकट दर, मुद्रा, पात्रता र सञ्चालन समय जाँच मितिको विवरण हो, अन्तिम बुकिङ वा हालको सेवा ग्यारेन्टी होइन। सञ्चालकका फरक समयलाई पानामा छुट्याइएको छ; अन्तिम टिकट, माथि जाने र तल झर्ने सेवा सञ्चालकसँग अलग पुष्टि गर्नुहोस्।</p>

    <h2>बौद्धिक सम्पत्ति</h2>
    <p>यस साइटका पाठ, लोगो र डिजाइन (अलग उल्लेख नभएसम्म) साइट सञ्चालकको सम्पत्ति हुन् र अनुमतिबिना प्रयोग, प्रतिलिपि वा वितरण गर्न पाइँदैन। सांकेतिक चित्र वास्तविक स्टेशनको फोटो, भवन डिजाइन वा सटीक नक्सा होइन र CC0 स्रोतबाट हो। Chandragiri Hills, केबल कार सञ्चालक, मन्दिर वा रिसोर्टका नाम/चिन्ह सम्बन्धित स्वामित्वका हुन्।</p>

    <h2>जिम्मेवारीको सीमा</h2>
    <p>यस साइट वा यसमा दिइएको जानकारीको प्रयोग वा प्रयोग गर्न नसक्दा हुने कुनै प्रत्यक्ष, अप्रत्यक्ष, आकस्मिक वा परिणामस्वरूप क्षतिका लागि हामी जिम्मेवार हुँदैनौँ। Maps स्थान-सन्दर्भ प्रत्यक्ष नापिएको प्रवेश, बोर्डिङ वा बाधारहित मार्ग होइन। मौसम क्षेत्रीय मोडेल हो; सम्पूर्ण लाइनको हावा, दृश्यता, मर्मत वा सुरक्षित सञ्चालन पुष्टि गर्दैन।</p>

    <p class="small">जाँच मिति: 2026-11-09।</p>
  </div></section>
</Base>
