---
import '../styles/global.css';

export const prerender = false;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://chandragiritop.com';
const pagePath = '/';
const canonical = `${siteUrl}${pagePath}`;
const ogImage = 'https://upload.wikimedia.org/wikipedia/commons/thumb/7/7d/View_from_chandragiri_32.jpg/1600px-View_from_chandragiri_32.jpg';

const place = {
  nameNe: 'चन्द्रागिरि केबल कार माथिल्लो स्टेसन',
  name: 'Chandragiri Cable Car Top Station',
  shortName: 'Chandragiri Top',
  city: 'Chandragiri',
  province: 'Bagmati Province',
  country: 'Nepal',
  address: 'M683+6V9, Kulekhani-Phakhel-Matatirtha Rd, Chandragiri, Bagmati Province 44600, Nepal',
  latitude: 27.667243,
  longitude: 85.205841,
  rating: 4.5,
  reviewCount: 10307,
  phone: '+977 1-4312515'
};

const mapsShareUrl = 'https://maps.app.goo.gl/Rgg86Zios8XGvSxV7';
const govtTourismUrl = 'https://www.welcomenepal.com/';
const reviewUpdatedMonth = '2026 年 9 月';
const reviewSourceNote = '同步自 Google 地图用户评价，同步时间 2026 年 9 月；版权归原作者与 Google 地图所有';
const reviewButtonLabel = '在谷歌地图查看全部评价';
const reviewInlineNote = '评分与评价数同步自谷歌地图（Google Maps）用户评价 · 2026 年 9 月 · 点击查看谷歌地图全部评价↗';

const openingHours = [
  ['सोमबार', '09:00–18:00'], ['मंगलबार', '09:00–18:00'], ['बुधबार', '09:00–18:00'],
  ['बिहीबार', '09:00–18:00'], ['शुक्रबार', '09:00–18:00'], ['शनिबार', '08:00–18:00'], ['आइतबार', '08:00–18:00']
];

const faq = [
  { q: 'केबल कारको यात्रा कति समय लाग्छ?', a: 'सामान्यतया करिब ९–१३ मिनेट लाग्छ। २.५ किमि लामो लाइनले थानकोटतर्फको तल्लो स्टेशनलाई चन्द्रागिरिको माथिल्लो स्टेशनसँग जोड्छ।' },
  { q: 'कुन समयमा जानु राम्रो?', a: 'हिमालको दृश्य प्राथमिकता हो भने बिहानको सफा आकाश राम्रो हुन्छ। बादल, हावा वा मर्मतका कारण दृश्य र सञ्चालनमा असर पर्न सक्छ, त्यसैले निस्कनुअघि आधिकारिक सञ्चालन सूचना हेर्नुहोस्।' },
  { q: 'माथि पुगेपछि के हेर्न सकिन्छ?', a: 'भालेश्वर महादेव मन्दिर, दृश्य टावर, काठमाडौँ उपत्यका र मौसम खुलेको दिन हिमालय शृङ्खलाको विस्तृत दृश्य मुख्य आकर्षण हुन्।' },
  { q: 'बालबालिका र ह्वीलचेयर प्रयोगकर्ताका लागि उपयुक्त छ?', a: 'सञ्चालकका अनुसार ह्वीलचेयर प्रयोगकर्तालाई चढ्न/ओर्लन कर्मचारीले सहयोग गर्छन्। ११ वर्ष वा कम उमेरका बालबालिकासँग कम्तीमा १५ वर्षका साथीसँग यात्रा गर्नुपर्ने जानकारी पनि आधिकारिक FAQ मा दिइएको छ।' },
  { q: 'कति समय छुट्याउने?', a: 'केबल कार, मन्दिर, दृश्य क्षेत्र र खानपान मिलाएर करिब ३–४ घण्टा सहज हुन्छ। मौसम राम्रो छ र गतिविधि थप्ने हो भने आधा दिन राख्नु उपयोगी हुन्छ।' },
  { q: 'Where is Chandragiri Cable Car Top Station located?', a: 'Chandragiri Cable Car Top Station is located in Chandragiri, Bagmati Province, Nepal, on the ridge southwest of the Kathmandu Valley at about 2,520 m above sea level.' },
  { q: 'Is Chandragiri Top free to visit?', a: 'No. The cable car is a paid service and tickets are required for the ride. Rates differ for Nepali, SAARC and foreign visitors, and discounts may apply to children, seniors and students with valid ID.' },
  { q: 'How long is the Chandragiri cable car ride?', a: 'A one-way ride takes about 9–13 minutes over the roughly 2.5 km line that connects the Thankot base station with the top station.' },
  { q: 'What are the Chandragiri cable car opening hours?', a: 'Generally 09:00–18:00 Sunday to Friday and 08:00–18:00 on Saturday and public holidays. Times can vary, so confirm on the official site before you travel.' },
  { q: 'What can I see at the top station?', a: 'Bhaleshwor Mahadev Temple, the view tower, panoramic Kathmandu Valley views and, on clear days, the Himalaya range are the main highlights.' }
];

const touristSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `${canonical}#attraction`,
  name: place.name,
  alternateName: [place.nameNe, place.shortName, `${place.city} ${place.name}`],
  description: `Comprehensive visitor guide to ${place.name} in ${place.city}, ${place.province}, ${place.country}.`,
  url: canonical,
  image: [ogImage],
  telephone: place.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'M683+6V9, Kulekhani-Phakhel-Matatirtha Rd',
    addressLocality: 'Chandragiri',
    addressRegion: 'Bagmati Province',
    postalCode: '44600',
    addressCountry: 'NP'
  },
  geo: { '@type': 'GeoCoordinates', latitude: place.latitude, longitude: place.longitude },
  hasMap: mapsShareUrl,
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday','Sunday'], opens: '08:00', closes: '18:00' }
  ],
  isAccessibleForFree: false,
  sameAs: [mapsShareUrl, govtTourismUrl]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({q,a}) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};

// ---- Real-time weather (Open-Meteo, server-side fetch + short TTL cache) ----
const WEATHER_TTL = 30 * 60 * 1000;
let _weatherCache = { ts: 0, value: null };

const neDays = ['आइतबार','सोमबार','मंगलबार','बुधबार','बिहीबार','शुक्रबार','शनिबार'];

function wmoInfo(code) {
  const map = {
    0: ['सफा आकाश', '☀️'], 1: ['मुख्यतया सफा', '🌤️'], 2: ['आंशिक बदली', '⛅'],
    3: ['बदली', '☁️'], 45: ['कुहिरो', '🌫️'], 48: ['कुहिरो', '🌫️'],
    51: ['हल्का टिप्पा', '🌦️'], 53: ['टिप्पा', '🌦️'], 55: ['बाक्लो टिप्पा', '🌦️'],
    56: ['हिम टिप्पा', '🌧️'], 57: ['हिम टिप्पा', '🌧️'],
    61: ['हल्का वर्षा', '🌧️'], 63: ['वर्षा', '🌧️'], 65: ['बाक्लो वर्षा', '🌧️'],
    66: ['हिम वर्षा', '🌧️'], 67: ['हिम वर्षा', '🌧️'],
    71: ['हल्को हिमपात', '🌨️'], 73: ['हिमपात', '❄️'], 75: ['बाक्लो हिमपात', '❄️'], 77: ['हिम कण', '🌨️'],
    80: ['वर्षाका फुहारा', '🌦️'], 81: ['वर्षाका फुहारा', '🌧️'], 82: ['बाक्लो वर्षा फुहारा', '⛈️'],
    85: ['हिम फुहारा', '🌨️'], 86: ['बाक्लो हिम फुहारा', '❄️'],
    95: ['आँधी / चट्याङ', '⛈️'], 96: ['आँधी / असिना', '⛈️'], 99: ['आँधी / असिना', '⛈️']
  };
  return map[code] ?? ['बदली', '🌥️'];
}

async function getWeather() {
  const now = Date.now();
  if (_weatherCache.value && now - _weatherCache.ts < WEATHER_TTL) return _weatherCache.value;
  const url = `https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}`
    + `&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,uv_index`
    + `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,sunrise,sunset&timezone=auto&forecast_days=7`;
  const res = await fetch(url, { cf: { cacheTtl: 1800, cacheEverything: true } });
  if (!res.ok) throw new Error('weather_fetch_failed');
  const data = await res.json();
  _weatherCache = { ts: now, value: data };
  return data;
}

// Wind speed (km/h) → Beaufort level
function beaufort(kmh) {
  const t = [1,5,11,19,28,38,49,61,74,88,102,117];
  let lvl = 0;
  for (let i = 0; i < t.length; i++) { if (kmh > t[i]) lvl = i + 1; }
  return lvl;
}
const windWords = ['हावा शान्त','हावा निकै कम','हावा कम','हावा मध्यम','हावा मध्यम','हावा चलेको','हावा बलियो','हावा बलियो','हावा धेरै बलियो','आँधी जस्तो','आँधी','तीव्र आँधी','कठोर आँधी'];

let weather = null, weatherError = false;
try { weather = await getWeather(); } catch (e) { weatherError = true; }

// ---- Smart, action-oriented advice (derived from weather fields) ----
let cur = null;
let advice = { outfit: [], plan: [], items: [], risk: [] };
if (weather?.current) {
  const pop = weather.daily?.precipitation_probability_max?.[0] ?? 0;
  const uv = weather.current.uv_index ?? (weather.daily?.uv_index_max?.[0] ?? 0);
  const windBft = beaufort(weather.current.wind_speed_10m);
  cur = {
    temp: Math.round(weather.current.temperature_2m),
    feels: Math.round(weather.current.apparent_temperature),
    humidity: weather.current.relative_humidity_2m,
    wind: Math.round(weather.current.wind_speed_10m),
    windBft,
    windWord: windWords[windBft] ?? 'हावा',
    code: weather.current.weather_code,
    precip: weather.current.precipitation ?? 0,
    pop,
    uv: Math.round(uv)
  };

  const heavy = [65,66,67,82,95,96,99].includes(cur.code) || ([61,63,80,81].includes(cur.code) && pop >= 50);
  const light = [51,53,55,56,57,61,80].includes(cur.code) || (pop >= 55 && !heavy);
  const storm = [95,96,99].includes(cur.code);
  const tmax = Math.round(weather.daily?.temperature_2m_max?.[0] ?? cur.temp);
  const tmin = Math.round(weather.daily?.temperature_2m_min?.[0] ?? cur.temp);
  const diff = tmax - tmin;

  // 🌂 Rain / precipitation
  if (storm) {
    advice.risk.push('चट्याङ / आँधी छ — चढाइ (केबल कार टावर/रिज) नगर्ने, रुखमुनि वा खुला ठाउँमा नबस्ने।');
    advice.plan.push('पानी/विद्युत जोखिममा — भित्रै बस्ने, बाहिरका स्लोप/टावर टार्ने।');
    advice.items.push('रेनकोट (लामो छाता हावामा टुट्न सक्छ)');
  } else if (heavy) {
    advice.risk.push('वर्षा बाक्लो छ — खोल्सा/निचो ठाउँबाट टाढा बस्ने; भिर/स्लोपमा माटो खस्न सक्छ, केबल कार सीमित हुन सक्छ।');
    advice.outfit.push('पानी जोगाउने ज्याकेट / रेनकोट लगाउनुहोस्।');
    advice.plan.push('घरभित्र/कभर गरिएका ठाउँ प्राथमिकता; खुला रिज र स्लोपमा कम हिँड्ने।');
    advice.items.push('रेनकोट (हावा भएकाले लामो छाता सिफारिस हुँदैन)');
  } else if (light) {
    advice.outfit.push('सानो पानी पर्न सक्छ — पानी जोगाउने लुगा वा फोल्डेबल छाता साथमा राख्नुहोस्।');
    advice.plan.push('बाटो भुस्याहा हुन सक्छ, सरकिन नसक्ने जुत्ता लगाउनुहोस्।');
  } else if (pop >= 60) {
    advice.outfit.push(`वर्षाको सम्भावना बढी (करिब ${pop}%) छ — छाता/रेनकोट साथमा राख्नुहोस् (तर "आज निश्चित वर्षा" होइन)।`);
  } else if (pop >= 40) {
    advice.outfit.push(`वर्षाको केही सम्भावना (${pop}%) छ — छाता बोक्न हानि छैन।`);
  }

  // 🌞 High temp & UV
  if (tmax >= 32) {
    advice.outfit.push('तापक्रम बढी छ — हल्का, सास फेर्न मिल्ने लुगा लगाउनुहोस्।');
    advice.plan.push('दिउँसोको चिप्लो समय (११–३ बजे) बाहिर छोटो राख्ने।');
  }
  if (cur.uv >= 5) {
    advice.outfit.push(`उचाइमा UV बलियो (${cur.uv}) छ — सनस्क्रिन, टोपी/कालो चश्मा लगाउनुहोस्।`);
    advice.items.push('सनस्क्रिन, कालो चश्मा, टोपी');
  }

  // ❄️ Low temp / day-night diff
  if (diff > 8) advice.outfit.push(`दिन/रातको तापक्रम फरक (${diff}°C+) बढी छ — तह-तह लुगा/ज्याकेट लैजानुहोस्।`);
  if (tmax <= 10) {
    advice.outfit.push('चिसो छ — तातो ज्याकेट/स्वेटर लगाउनुहोस्।');
    advice.items.push('हातमुटे, टोपी');
  }

  // 💨 Wind
  if (windBft >= 7) {
    advice.risk.push(`हावा धेरै बलियो (${windBft} तह) छ — माथिल्लो स्टेशन/रिजमा सावधान, केबल कार सीमित वा रोकिन सक्छ।`);
    advice.plan.push('खुला रिज र टायो/बोर्डबाट टाढा बस्ने।');
  } else if (windBft >= 5) {
    advice.plan.push(`हावा चलेको (${windBft} तह) छ — माथि खुला ठाउँमा सावधान, टोपी उड्न सक्छ।`);
    advice.items.push('टोपी कस्ने डोरी/ब्यान्ड');
  }

  // ☀️/☁️ Sunny / cloudy
  if (cur.code <= 1) advice.plan.push('मौसम सफा छ — हिमाल/सूर्योदय-सूर्यास्त राम्रो; दृश्य फोटो अवसर।');
  else if (cur.code <= 3) advice.plan.push('उज्यालो मध्यम (बदली) छ — फोटो र लामो हिँडाइ उपयुक्त, सीधा घाम कम।');

  // 🌫️ Fog
  if (cur.code === 45 || cur.code === 48) {
    advice.risk.push('कुहिरो छ — माथिबाट हिमाल/दृश्य नदेखिन सक्छ; बिहान/बेलुका सावधान, बाटो खुस्किन सक्छ।');
  }

  // Mountain fallback (Chandragiri = ridge viewpoint)
  if (advice.outfit.length === 0) advice.outfit.push('सामान्य लुगा ठीक छ; उचाइमा हावा चल्न सक्छ, एउटा हल्को ज्याकेट राख्दा फाइदा।');
  if (advice.plan.length === 0) advice.plan.push('मौसम सामान्य छ — सूचीअनुसार यात्रा गर्न सकिन्छ।');
}
const [curLabel, curIcon] = wmoInfo(cur?.code ?? 0);

// ---- Visitor facilities (type-neutral, no specific merchants) ----
const facilities = [
  ['शौचालय / WC', 'माथिल्लो र तल्लो स्टेशन दुवैमा सार्वजनिक शौचालय छन्। शिखरमा जानुअघि पहिलो पटक प्रयोग गर्न सिफारिस गरिन्छ।'],
  ['पार्किङ', 'तल्लो (थानकोट) स्टेशनमा निजी सवारी र दुईपाङ्ग्रे वाहनका लागि पार्किङ क्षमता छ। व्यस्त दिन चाँडै पुग्नुहोस्।'],
  ['भोजन', 'माथिल्लो परिसरमा स्न्याक्सदेखि बहु-परिकार भोजनसम्म विविध विकल्प; धार्मिक क्षेत्र नजिकै शाकाहारी विकल्प प्राथमिकता हुन सक्छ।'],
  ['बसाइ (लज / रिसोर्ट)', 'चन्द्रागिरि हिल्स परिसर र नजिकैका बसोबास क्षेत्रमा विभिन्न श्रेणीका बासस्थान उपलब्ध छन्।'],
  ['पसल / स्मृति', 'माथिल्लो परिसरमा साना पसल / स्मृति केन्द्र छन्; नगद र डिजिटल भुक्तानी दुवै सञ्चालनमा छन् कि छैनन् अगाडि जाँच गर्नुहोस्।'],
  ['इन्धन / चार्जिङ', 'तल्लो स्टेशन नजिकै इन्धन स्टेसन र विद्युतीय सवारीका लागि चार्जिङ बिन्दु छन्; भरिनै आउन सिफारिस गरिन्छ।'],
  ['सहायता / प्राथमिक उपचार', 'परिसरमा सुरक्षा कर्मचारी र प्राथमिक सहायता उपलब्ध हुन्छ; आपतकालीन सम्पर्क आफैंसँग राख्नुहोस्।']
];

// ---- Seasonal travel strategy (based on long-term local climate trend; verify before travel) ----
const seasons = [
  ['हिउँद (डिसेम्बर–फेब्रुअरी)', 'चिसो; बिहान कुहिरो हुन सक्छ, दिउँसो सफा', 'हिमाल दृश्य उत्कृष्ट', 'तातो लुगा, हातमुटे, टोपी', 'स्पष्ट हिमाल दृश्य, फोटोग्राफी'],
  ['वसन्त (मार्च–मे)', 'राम्रो; फूल र सफा आकाश', 'दृश्य राम्रो', 'हल्का ज्याकेट, पानी', 'परिवार भ्रमण, हल्का हाइकिङ'],
  ['वर्षा (जुन–अगस्ट)', 'मनसुन; बादल, कहिलेकाहीँ वर्षा', 'दृश्य कहिलेकाहीँ रोकिन्छ', 'छाता / रेनकोट', 'हरियाली, तथा कम भीड'],
  ['शरद् (सेप्टेम्बर–नोभेम्बर)', 'वर्षकै सफा; पछिल्लो मनसुनपछि', 'हिमाल र उपत्यका स्पष्ट', 'हल्का ज्याकेट', 'सबैभन्दा उत्तम समय, दृश्य यात्रा']
];

// ---- Routes by traveller type ----
const groupRoutes = [
  ['आफन्त / बालबालिकासँग', ['केबल कारमा माथि (कम्पन कम, सुरक्षित)', 'भालेश्वर महादेव मन्दिर (छोटो हिँडाइ)', 'दृश्य टावरबाट ३६०° दृश्य', 'भोजन क्षेत्रमा स्न्याक्स / खाजा', 'खेल्ने र फिर्ता जाने समय सीमित राख्ने']],
  ['फोटोग्राफी / प्रकृति', ['बिहानै पुग्ने (सफा प्रकाश, कुहिरोभन्दा अघि)', 'दृश्य टावर र लुकआउटमा प्यानोरमा', 'हिमालयमा घाम लाग्दा सुनौलो दृश्य', 'बेलुका सुनसान समयमा चरा / वन्यजन्तु अवलोकन', 'तिरै र ब्याट्री थप बोक्ने']],
  ['कम श्रम / पहुँचयोग्य', ['केबल कार (बैठक यात्रा, सीढी कम)', 'माथिल्लो परिसरको पहुँचयोग्य मार्ग', 'भोजन / विश्राम क्षेत्रमा बसाइ', 'धेरै हिँडाइ नगरी दृश्य मात्र', 'सहायक सामग्री / व्हीलचेयर साथमा']]
];

// ---- General routes (half / full day) ----
const generalRoutes = [
  ['अर्धदिन (३–४ घण्टा)', ['थानकोट (तल्लो स्टेशन) आगमन', 'केबल कारमा माथि', 'मन्दिर + दृश्य टावर', 'स्न्याक्स र फिर्ता']],
  ['पूर्ण दिन (६–८ घण्टा)', ['बिहानै आगमन', 'केबल कार + मन्दिर + टावर', 'भोजन क्षेत्रमा दिउँसो खाना', 'लुकआउट / हल्का ट्रेल', 'सूर्यास्तअघि फिर्ता']]
];
