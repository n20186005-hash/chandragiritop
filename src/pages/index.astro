        <div class="flex flex-wrap gap-4 text-sm font-semibold text-white/75"><a href="#tickets">टिकट</a><a href="#map">नक्सा</a><button id="cookie-settings" type="button">Cookie सेटिङ</button><a href="/privacy/">गोपनीयता</a><a href="/terms/">सर्तहरू</a></div>
      </div>
