---
import Base from '../../layouts/Base.astro';
export const prerender = true;
---
<Base title="कुकी सेटिङ | चन्द्रागिरि गाइड" description="आवश्यक, वैकल्पिक विश्लेषण र बाह्य कुकीको वर्गीकरण र Google Analytics रोजाइ परिवर्तन।" noindex>
  <section class="section"><div class="shell prose">
    <h1>कुकी सेटिङ</h1>
    <p>यहाँ आफ्नो कुकी रोजाइ व्यवस्थापन गर्न सकिन्छ। तलका वर्गीकरण अनुसार आवश्यक कुकी सधैं सक्रिय हुन्छन्, विश्लेषण कुकी तपाईंले सहमत भएपछि मात्र लोड हुन्छ।</p>

    <h2>आवश्यक कुकी</h2>
    <p><strong>सधैं सक्रिय।</strong> साइटको आधारभूत कार्य (भाषा प्राथमिकता, कुकी रोजाइको सुरक्षित राख्ने, सुरक्षा) का लागि आवश्यक; यसलाई बन्द गर्न सकिँदैन।</p>

    <h2>वैकल्पिक विश्लेषण कुकी</h2>
    <p>तपाईंले स्वीकार गरेपछि मात्र Google Analytics (बाह्य) लोड हुन्छ र भ्रमण, पानादृश्य, ब्राउजर/उपकरण मापन गर्छ। यो स्वतन्त्र Cloudflare होस्टिङ मापनभन्दा फरक हो।</p>

    <h2>बाह्य र मार्केटिङ कुकी</h2>
    <p>यो साइटले आफैं मार्केटिङ वा विज्ञापन कुकी प्रयोग गर्दैन। तथापि, नक्सा, टिकट वा अन्य बाह्य लिंक खोल्दा सम्बन्धित प्रदायकका कुकी र नियम लागू हुन्छन्।</p>

    <h2>रोजाइ परिवर्तन गर्ने</h2>
    <p>तपाईंको रोजाइ ब्राउजरको localStorage मा राखिन्छ। तलको बटनबाट रोजाइ खोल्नुहोस्, स्वीकार वा अस्वीकार छान्नुहोस्; पहिले लोड भएको अवस्थामा मापन निष्क्रिय पारिन्छ र रोजाइ सुरक्षित भए पाना फेरि लोड हुन्छ। ब्राउजरले रोजाइ राख्न नदिए साइट डेटा सेटिङ जाँच्नुहोस्।</p>
    <p><button type="button" data-cookie-settings>रोजाइ खोल्नुहोस्</button></p>
  </div></section>
</Base>
