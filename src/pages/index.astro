            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur"><strong class="block text-2xl">९–१३ मिनेट</strong><span class="text-xs text-white/70">एकतर्फी यात्रा</span></div>
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur"><strong class="block text-2xl">४.५ ★</strong><span class="text-xs text-white/70">१०,३०७ समीक्षा</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- English SEO entity-binding guide (added; existing Nepali content preserved) -->
    <section class="py-20 md:py-28 bg-[#f6f3e7]">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <p class="text-sm font-black uppercase tracking-[.25em] text-[#9b7622]">Visitor Guide · Chandragiri Top</p>
        <h2 class="mt-3 text-4xl font-black md:text-5xl">About Chandragiri Cable Car Top Station</h2>
        <p class="mt-6 max-w-3xl leading-8 text-[#53675e]">Welcome to <strong>Chandragiri Cable Car Top Station</strong>, widely recognized as the central <strong>Chandragiri Top</strong>. Located in the heart of <strong>Chandragiri</strong>, <strong>Bagmati Province</strong>, <strong>Nepal</strong>, this destination serves as a primary hub for travelers visiting the region.</p>
        <p class="mt-4 text-sm font-semibold text-[#69856a]">Chandragiri Cable Car Top Station → Chandragiri → Bagmati Province → Nepal</p>
        <p class="mt-6 max-w-3xl leading-8 text-[#53675e]">When visiting <strong>Chandragiri Cable Car Top Station</strong>, visitors can easily explore surrounding historical landmarks and points of interest, including <strong>Bhaleshwor Mahadev Temple</strong> and <strong>Kathmandu Valley</strong>.</p>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <div>
            <h2 class="text-3xl font-black">Location &amp; How to Visit Chandragiri Top in Chandragiri</h2>
            <p class="mt-5 leading-8 text-[#53675e]">The top station sits at about 2,520 m above sea level in Chandragiri, Bagmati Province, Nepal. The cable car runs from the Thankot base station up to the top station, with a one-way ride of roughly 9–13 minutes.</p>
          </div>
          <div>
            <h2 class="text-3xl font-black">Landmarks &amp; Attractions Around Chandragiri Top</h2>
            <p class="mt-5 leading-8 text-[#53675e]">Around the top station you'll find Bhaleshwor Mahadev Temple, the view tower, the Chandragiri Hills lookout and the historical settlement of Thankot.</p>
          </div>
        </div>
        <h2 class="mt-12 text-3xl font-black">History &amp; Significance of Chandragiri Cable Car Top Station</h2>
        <p class="mt-5 max-w-3xl leading-8 text-[#53675e]">Chandragiri is a hill renowned for its panoramic Himalaya views and the sacred Bhaleshwor Mahadev Temple. The cable car connects the Kathmandu Valley rim to the summit, making the top station a key viewpoint and pilgrimage stop.</p>
      </div>
    </section>

    <!-- Real-time weather (server-rendered via Open-Meteo; no API/key commentary shown to visitors) -->
    <section id="weather" class="py-20 md:py-28 bg-[#0b2a3a] text-white">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <p class="text-sm font-black uppercase tracking-[.25em] text-[#7fd3e8]">मौसम • अहिले चन्द्रागिरि</p>
        <h2 class="mt-3 text-4xl font-black md:text-5xl">अहिलेको मौसम र आगामी दिन</h2>

        {weatherError && (
          <p class="mt-6 rounded-3xl border border-white/15 bg-white/5 p-6 text-white/80">मौसम डाटा अहिले अनुपलब्ध छ। यात्राअघि आधिकारिक मौसम स्रोत जाँच गर्नुहोस्।</p>
        )}

        {cur && (
          <div class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_1.4fr]">
            <div class="rounded-[2.5rem] border border-white/10 bg-white/5 p-8">
              <div class="flex items-center gap-4"><span class="text-6xl">{curIcon}</span><div><div class="text-6xl font-black">{cur.temp}°C</div><div class="text-white/70">{curLabel}</div></div></div>
              <p class="mt-5 text-white/75">अनुभूत तापक्रम <strong class="text-white">{cur.feels}°C</strong> · हावा <strong class="text-white">{cur.wind} किमि/घण्टा</strong> · आर्द्रता <strong class="text-white">{cur.humidity}%</strong></p>
              {needUmbrella
                ? <p class="mt-4 rounded-2xl bg-[#f1c75b] px-4 py-3 text-sm font-bold text-[#10231d]">आज वर्षाको सम्भावना छ — छाता वा रेनकोट साथमा राख्नुहोस्।</p>
                : <p class="mt-4 rounded-2xl bg-white/10 px-4 py-3 text-sm font-bold text-white/85">आज छाताको आवश्यकता कम छ; तर हावा वा मौसम बदलिन सक्छ।</p>}
            </div>

            <div class="rounded-[2.5rem] border border-white/10 bg-white/5 p-6">
              <p class="text-sm font-black uppercase tracking-[.2em] text-[#7fd3e8]">आगामी ७ दिन</p>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
                {weather.daily.time.map((t, i) => {
                  const parts = t.split('-').map(Number);
                  const wd = neDays[new Date(parts[0], parts[1]-1, parts[2]).getDay()];
                  const [label, icon] = wmoInfo(weather.daily.weather_code[i]);
                  const hi = Math.round(weather.daily.temperature_2m_max[i]);
                  const lo = Math.round(weather.daily.temperature_2m_min[i]);
                  const pop = weather.daily.precipitation_probability_max[i];
                  return (
                    <div class="rounded-2xl bg-white/5 p-3 text-center">
                      <div class="text-xs text-white/60">{i === 0 ? 'आज' : wd}</div>
                      <div class="my-2 text-3xl">{icon}</div>
                      <div class="text-sm font-black">{hi}° / {lo}°</div>
                      <div class="mt-1 text-[10px] leading-3 text-white/55">{label}</div>
                      <div class="mt-1 text-[10px] text-[#7fd3e8]">वर्षा {pop}%</div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        <p class="mt-6 text-xs text-white/50">मौसम डाटा: <a href="https://open-meteo.com/" rel="noopener" target="_blank" class="underline">Open-Meteo</a> — यात्राअघि वास्तविक अवस्था जाँच गर्नुहोस्।</p>
